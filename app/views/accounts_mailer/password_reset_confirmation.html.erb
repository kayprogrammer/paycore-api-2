<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8" />
  <style>
    body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; background: #f4f6f9; margin: 0; padding: 20px; }
    .card { background: #ffffff; border-radius: 12px; max-width: 520px; margin: 0 auto; padding: 40px; box-shadow: 0 2px 8px rgba(0,0,0,0.08); }
    .logo { font-size: 24px; font-weight: 700; color: #1a1a2e; margin-bottom: 32px; }
    .logo span { color: #6c63ff; }
    h2 { font-size: 20px; color: #1a1a2e; margin: 0 0 12px; }
    p { color: #555; font-size: 15px; line-height: 1.6; margin: 0 0 16px; }
    .footer { margin-top: 32px; font-size: 12px; color: #aaa; text-align: center; }
  </style>
</head>
<body>
  <div class="card">
    <div class="logo">Pay<span>Core</span></div>
    <h2>Password Changed Successfully</h2>
    <p>Hi <%= @user.first_name %>, your PayCore password has been reset successfully.</p>
    <p>If you did not make this change, please contact our support team immediately.</p>
    <div class="footer">PayCore &mdash; Secure Fintech Infrastructure</div>
  </div>
</body>
</html>
